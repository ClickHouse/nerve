# Nerve — Machine-local configuration
# Settings specific to this box: workspace location,
# bind address, deployment style, local credentials handles.
# Shared behaviour lives in <workspace>/config/settings.yaml,
# which this file overrides. Secrets go in config.local.yaml.

workspace: <root>/workspace
deployment: docker
provider:
  aws_profile: nerve-worker
proxy:
  enabled: true
  port: 8317
docker:
  extra_mounts: []
