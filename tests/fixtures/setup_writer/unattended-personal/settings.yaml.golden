# Nerve — Shared configuration
# Git-tracked and portable: this is the layer that syncs between machines and
# the one lockdown mode trusts. Machine-specific values belong in config.yaml,
# which overrides this file. Secrets belong in config.local.yaml or behind an
# ${ENV_VAR} reference — never here.
#
# `nerve init` owns the keys it generates and rewrites them on re-run. Keys it
# does not generate are left alone.

timezone: Europe/Berlin
gateway:
  host: 0.0.0.0
  port: 8900
agent:
  model: claude-opus-5-5
  cron_model: claude-sonnet-5-5
  max_turns: 1000
  max_concurrent: 32
  thinking: max
  effort: xhigh
  context_1m: true
quiet_start: 02:00
quiet_end: 08:00
memory:
  recall_model: claude-sonnet-5-5
  memorize_model: claude-sonnet-5-5
  fast_model: claude-haiku-5-5
  embed_model: text-embedding-3-small
  categories:
  - name: personal_info
    description: Identity, contact details, timezone, background
  - name: preferences
    description: Communication style, tool preferences, how things should be done
  - name: relationships
    description: People, dynamics, contact context
  - name: work
    description: Job, projects, PRs, code reviews, meetings
  - name: infrastructure
    description: Servers, deployments, CI/CD, system ops
  - name: finances
    description: Accounts, payments, subscriptions, budgets
  - name: tasks_deadlines
    description: Active tasks, deadlines, pending follow-ups
  - name: conversations
    description: Key things said, promises, follow-ups
  - name: agent_ops
    description: Operational lessons, memory design, prompt tuning
  - name: people
    description: Information and facts about people
sessions:
  sticky_period_minutes: 120
  archive_after_days: 30
  max_sessions: 500
  memorize_interval_minutes: 30
telegram:
  dm_policy: pairing
  stream_mode: partial
sync:
  telegram:
    enabled: false
  gmail:
    enabled: false
  github:
    enabled: false
  github_events:
    enabled: false
  github_repos:
    enabled: false
    repos: []
provider:
  type: anthropic
